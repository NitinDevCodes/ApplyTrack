NODE_ENV=development
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/applytrack
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Production requires an explicit HTTPS origin, without /api or other paths.
CLIENT_URL=http://127.0.0.1:5173
# Set to 1 only when deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=0
