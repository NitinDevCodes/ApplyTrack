{
  "name": "applytrack",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": { "node": "24.x" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:local": "node scripts/local-dev.mjs",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run build && npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server-core": "^10.2.3",
    "supertest": "^7.1.4"
  }
}
